BOT_TOKEN=your_telegram_bot_token_here
DATABASE_PATH=data/bot.sqlite
ADMIN_IDS=
MONEY_ACCEPT_CARD=
CHANNEL_DAGESTAN_ID=
CHANNEL_INGUSH_ID=
CHANNEL_CHECHEN_ID=
CHANNEL_COVERED_ID=
CHANNEL_EVERYTHING_ID=
LOG_LEVEL=info
LOG_COLOR=auto
LOG_TIMEZONE=Europe/Moscow

# FreeKassa (leave FREEKASSA_MERCHANT_ID empty to disable)
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET_1=
FREEKASSA_SECRET_2=
# Leave empty to use the official FreeKassa IP list
FREEKASSA_ALLOWED_IPS=

# xRocket Pay crypto payments (leave XROCKET_API_KEY empty to disable).
# App must use API Version = Current; both tokens are in @xRocket -> Pay API -> your app.
XROCKET_API_KEY=
XROCKET_WEBHOOK_SECRET=
XROCKET_CURRENCY=USDT
# Optional: per-invoice webhook URL; otherwise set it in the xRocket app settings
XROCKET_WEBHOOK_URL=

# Webhook HTTP server. Keep 127.0.0.1 behind a reverse proxy (Caddy/nginx)
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
HTTP_TRUST_PROXY=true
